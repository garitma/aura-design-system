{
  "compilerOptions": {
    "target": "es2018",
    "lib": ["es2018"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "typeRoots": [
      "../../node_modules/@types"
    ]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}

