{
  "name": "@aura-design/registry",
  "version": "1.0.0",
  "description": "Aura Design System Registry",
  "type": "module",
  "keywords": [],
  "author": "Pablo Orozco <me@pablopvsky.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garitma/aura-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/garitma/aura-design-system/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "pnpm ladle preview",
    "build": "pnpm ladle build -o build",
    "dev": "pnpm ladle serve",
    "registry:serve": "pnpm dlx serve public -p 6000",
    "registry:build": "shadcn build -o ../../apps/www/public/r",
    "registry:generate": "npx tsx scripts/build-registry.ts",
    "docs:generate": "npx tsx scripts/generate-docs.ts",
    "registry:bootstrap": "pnpm registry:generate && pnpm registry:build && pnpm docs:generate",
    "test": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ladle/react": "^5.1.1",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.14",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "ajv-formats": "^3.0.1",
    "bezier-easing": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "colorjs.io": "^0.5.2",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "radix-ui": "^1.1.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "3.5.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.14",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.13"
  }
}
