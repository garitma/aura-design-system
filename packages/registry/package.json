{
  "name": "@aura-design/registry",
  "version": "1.0.0",
  "description": "Aura Design System CLI",
  "type": "module",
  "keywords": [
    "react",
    "react-component",
    "uikit",
    "ui-library",
    "ui-components",
    "cli"
  ],
  "author": "Pablo Orozco <me@pablopvsky.com>",
  "license": "MIT",
  "bin": {
    "aura": "./dist/bin/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garitma/aura-design-system.git"
  },
  "bugs": {
    "url": "https://github.com/garitma/aura-design-system/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "commander": "^11.0.0",
    "fs-extra": "^11.3.0",
    "radix-ui": "^1.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "2.5.0-canary.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
