// Aura Design System

a
    text-decoration: none
    color var(--aura-link)
    &:visited:not([class*='button-'])
        color: inherit
    &:active
        outline: var(--aura-outline)

.button
    cursor pointer
    box-sizing: border-box
    margin: 0px
    letter-spacing: normal
    word-spacing: normal
    text-transform: none
    text-indent: 0px
    text-shadow: none
    font: inherit
    mixin-align-items(center)
    mixin-border-radius(var(--aura-button-radius))
    // One transition list. A second `transition` declaration would drop the background fade.
    transition: background-color 300ms cubic-bezier(0.4, 0, 0.6, 1), transform 250ms cubic-bezier(0.2, 0.8, 0.4, 1)
    -webkit-transition: background-color 300ms cubic-bezier(0.4, 0, 0.6, 1), transform 250ms cubic-bezier(0.2, 0.8, 0.4, 1)
    -moz-transition: background-color 300ms cubic-bezier(0.4, 0, 0.6, 1), transform 250ms cubic-bezier(0.2, 0.8, 0.4, 1)
    font-weight: 600
    display inline-flex
    height calc(var(--aura) * 4)
    padding 0 calc(var(--aura) * 2)
    border 2px solid
    justify-content: center;
    // Icons and labels are laid out by the button, never by margins on the icon.
    gap: var(--aura-button-gap, calc(var(--aura) * 0.5))
    &:disabled
        @extend .disabled
    &:hover&:hover:not(:disabled)
        transform: scale(1.03);
    &:active&:hover:not(:disabled)
        transform: scale(0.97);
        outline: var(--aura-outline)
    &:focus-visible
        outline: var(--aura-outline)
    @media (prefers-reduced-motion: reduce)
        &:hover&:hover:not(:disabled),
        &:active&:hover:not(:disabled)
            transform: none
    &[data-loading]:disabled
        opacity: 1
        cursor: default
    &[data-day]
        font-size: calc(14 / 17 * 1rem)
        font-weight: 500
        line-height: 1.4rem
.button-fill
    @extend .button
    border-color var(--aura-accents-primary)
    color var(--aura-text-primary-inverse)
    background-color var(--aura-accents-primary)
    &:hover:not(:disabled), &.active
        background-color var(--aura-button-hover)
.button-pill
    @extend .button
    color var(--aura-accents-primary)
    border-color var(--aura-accents-primary)
    background-color transparent
    &:hover:not(:disabled), &.active
        background-color var(--aura-link-hover)
.button-link
    @extend .button
    color: var(--aura-link)
    border: 0
    text-decoration: underline
    background-color transparent
    &:hover:not(:disabled), &.active
        color: var(--aura-base-color)
        background-color: var(--aura-link-hover)
.button-menu
    @extend .button
    font-weight: bold
    padding: calc(var(--aura) * 0.5) var(--aura)
    border: 0
    text-decoration: none

    
   

