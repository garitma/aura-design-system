{
  "$schema": "http://ui.shadcn.com/schema/registry.json",
  "name": "auradesign",
  "homepage": "http://auradesignsystem.com",
  "items": [
    {
      "name": "header",
      "type": "registry:component",
      "description": "Header content",
      "files": [
        {
          "path": "registry/default/components/Header.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "footer",
      "type": "registry:component",
      "description": "Footer content",
      "files": [
        {
          "path": "registry/default/components/Footer.tsx",
          "type": "registry:component"
        }
      ]
    },

    {
      "name": "n-progress",
      "type": "registry:component",
      "description": "A customizable progress bar component for Next.js applications, providing visual feedback during page transitions and data loading.",
      "dependencies": ["next-nprogress-bar"],
      "css": {
        "@layer components": {
          ".nprogress": {
            "pointer-events": "none",
            "z-index": "99999"
          },
          ".nprogress .bar": {
            "background": "var(--aura-loader)",
            "position": "fixed",
            "z-index": "99999",
            "top": "0",
            "left": "0",
            "width": "100%",
            "height": "4px"
          }
        }
      },
      "files": [
        {
          "path": "registry/default/components/Nprogress.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "layout-pancake",
      "type": "registry:component",
      "description": "Layout Header content and Footer",
      "registryDependencies": [
        "https://auradesignsystem.com/r/header.json",
        "https://auradesignsystem.com/r/footer.json",
        "https://auradesignsystem.com/r/n-progress.json"
      ],
      "files": [
        {
          "path": "registry/default/components/LayoutPancake.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "home-hello",
      "type": "registry:page",
      "description": "Hello Aura Home",
      "files": [
        {
          "path": "registry/default/pages/hello/page.tsx",
          "type": "registry:page",
          "target": "app/page.tsx"
        },
        {
          "path": "registry/default/pages/hello/layout.tsx",
          "type": "registry:page",
          "target": "app/layout.tsx"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "description": "button component",
      "dependencies": ["@aura-design/system"],
      "files": [
        {
          "path": "registry/default/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "form",
      "type": "registry:component",
      "description": "Form component",
      "dependencies": ["radix-ui", "ajv", "ajv-formats", "ajv-errors"],
      "registryDependencies": [
        "https://auradesignsystem.com/r/use-dynamic-form.json",
        "https://auradesignsystem.com/r/web-validation.json"
      ],
      "files": [
        {
          "path": "registry/default/components/form.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "web-validation",
      "type": "registry:lib",
      "dependencies": ["radix-ui", "ajv", "ajv-formats", "ajv-errors"],
      "description": "Web validation ajv ",
      "files": [
        {
          "path": "registry/default/utils/web-validation.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "use-dynamic-form",
      "type": "registry:hook",
      "description": "flexible form state management solution designed to handle dynamic forms with various field types",
      "files": [
        {
          "path": "registry/default/hooks/use-dynamic-form.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "alert",
      "type": "registry:ui",
      "description": "alert component",
      "dependencies": ["@radix-ui/react-icons"],
      "files": [
        {
          "path": "registry/default/ui/alert.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
