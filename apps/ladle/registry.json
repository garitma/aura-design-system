{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "auradesign",
  "homepage": "https://auradesignsystem.com",
  "items": [
    {
      "name": "accordion",
      "type": "registry:ui",
      "description": "accordion component",
      "dependencies": ["radix-ui", "@radix-ui/react-icons", "tw-animate-css"],
      "cssVars": {
        "theme": {
          "--animate-accordion-open": "slideDownAccordion 250ms ease-in-out",
          "--animate-accordion-closed": "slideUpAccordion 250ms ease-in-out"
        }
      },
      "css": {
        "@keyframes slideDownAccordion": {
          "from": {
            "height": "0"
          },
          "to": {
            "height": "var(--radix-accordion-content-height)"
          }
        },
        "@keyframes slideUpAccordion": {
          "from": {
            "height": "var(--radix-accordion-content-height)"
          },
          "to": {
            "height": "0"
          }
        }
      },
      "files": [
        {
          "path": "registry/default/ui/accordion.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "alert",
      "type": "registry:ui",
      "description": "alert component",
      "dependencies": ["@radix-ui/react-icons"],
      "files": [
        {
          "path": "registry/default/ui/alert.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "alert-dialog",
      "type": "registry:ui",
      "description": "Alert dialog component",
      "dependencies": ["radix-ui", "@radix-ui/react-icons"],
      "cssVars": {
        "theme": {
          "--animate-overlay-show": "overlayShow 500ms cubic-bezier(0.19, 1, 0.22, 1)",
          "--animate-content-show": "contentShow 500ms cubic-bezier(0.19, 1, 0.22, 1)"
        }
      },
      "css": {
        "@keyframes overlayShow": {
          "from": {
            "opacity": "0"
          },
          "to": {
            "opacity": "1"
          }
        },
        "@keyframes contentShow": {
          "from": {
            "opacity": "0",
            "transform": "scale(0.96)"
          },
          "to": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        }
      },
      "files": [
        {
          "path": "registry/default/ui/alert-dialog.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "description": "button component",
      "dependencies": ["@aura-design/system"],
      "files": [
        {
          "path": "registry/default/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "form",
      "type": "registry:component",
      "description": "Form component",
      "dependencies": ["radix-ui", "ajv", "ajv-formats", "ajv-errors"],
      "registryDependencies": [
        "https://auradesignsystem.com/r/use-dynamic-form.json",
        "https://auradesignsystem.com/r/web-validation.json"
      ],
      "files": [
        {
          "path": "registry/default/components/form.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "web-validation",
      "type": "registry:lib",
      "dependencies": ["radix-ui", "ajv", "ajv-formats", "ajv-errors"],
      "description": "Web validation ajv ",
      "files": [
        {
          "path": "registry/default/utils/web-validation.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "use-dynamic-form",
      "type": "registry:hook",
      "description": "flexible form state management solution designed to handle dynamic forms with various field types",
      "files": [
        {
          "path": "registry/default/hooks/use-dynamic-form.ts",
          "type": "registry:hook"
        }
      ]
    },
    {
      "name": "n-progress",
      "type": "registry:component",
      "description": "accordion component",
      "dependencies": ["next-nprogress-bar"],
      "css": {
        "@layer components": {
          ".nprogress": {
            "pointer-events": "none",
            "z-index": "99999"
          },
          ".nprogress .bar": {
            "background": "var(--aura-loader)",
            "position": "fixed",
            "z-index": "99999",
            "top": "0",
            "left": "0",
            "width": "100%",
            "height": "4px"
          }
        }
      },
      "files": [
        {
          "path": "registry/default/components/n-progress.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
